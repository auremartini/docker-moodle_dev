a:3:{s:10:"pluginname";s:22:"Comportamento mancante";s:24:"questionusedunknownmodel";s:203:"Questa domanda ha ricevuto risposte con un comportamento che non è al momento disponibile. Stiamo provando a visualizzare la domanda al meglio, tuttavia alcune parti potrebbero essere mancanti o errate.";s:16:"privacy:metadata";s:86:"Il plugin Comportamenti domanda 'Comportamento mancante' non memorizza dati personali.";}