a:4:{s:10:"modulename";s:8:"Proposte";s:15:"modulename_help";s:176:"Preset da utilizzare per raccogliere proposte di argomenti, ricerche, progetti, eccetera. Sono inlcusi campi per indicare lo stato di approvazione, rifiuto, revisione o attesa.";s:10:"pluginname";s:8:"Proposta";s:16:"privacy:metadata";s:48:"Il plugin Proposta non memorizza dati personali.";}