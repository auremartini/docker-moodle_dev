a:4:{s:10:"pluginname";s:26:"Risposte inglobate (Cloze)";s:15:"pluginname_help";s:129:"Il formato Risposte inglobate (Cloze) consente l'importazione di testi contenenti domande a risposta multiple e a risposta breve.";s:15:"pluginname_link";s:25:"question/type/multianswer";s:16:"privacy:metadata";s:68:"Il plugin 'Risposte inglobate (Cloze)' non memorizza dati personali.";}