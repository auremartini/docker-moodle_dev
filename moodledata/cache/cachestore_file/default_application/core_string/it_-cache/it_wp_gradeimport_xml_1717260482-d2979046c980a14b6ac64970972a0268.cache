a:17:{s:15:"errbadxmlformat";s:33:"Errore - formato XML non corretto";s:25:"errduplicategradeidnumber";s:119:"Errore - ci sono due elementi di valutazione in questo corso con idnumber '{$a}'. Questo non dovrebbe essere possibile.";s:20:"errduplicateidnumber";s:27:"Errore - idnumber duplicato";s:25:"errincorrectgradeidnumber";s:101:"Errore - l'idnumber '{$a}' dal file di importazione non corrisponde ad alcun elemento di valutazione.";s:20:"errincorrectidnumber";s:24:"Errore - idnumber errato";s:24:"errincorrectuseridnumber";s:84:"Errore - l'idnumber '{$a}' dal file di importazione non corrisponde a nessun utente.";s:5:"error";s:28:"Si stanno verificando errori";s:17:"errorduringimport";s:55:"Si è verificato un errore durante l'importazione: {$a}";s:7:"fileurl";s:19:"URL del file remoto";s:12:"fileurl_help";s:123:"Il campo serve per indicare l'URL remoto di un server dal quale prendere i dati, ad esempio uno student information system.";s:10:"pluginname";s:8:"File XML";s:16:"privacy:metadata";s:87:"Il plugin per l'importazione delle valutazioni 'File XML' non memorizza dati personali.";s:11:"xml:publish";s:42:"Pubblicare le valutazioni importate da XML";s:8:"xml:view";s:31:"Importare le valutazioni da XML";s:9:"importxml";s:16:"Importazione XML";s:14:"importxml_help";s:250:"Le valutazioni possono essere importate tramite un file XML contenente i codici identificativi degli utenti e delle attività. Per conoscere il formato da utilizzare, puoi esportare delle valutazioni in formato XML e visualizzare il formato del file.";s:14:"importxml_link";s:22:"grade/import/xml/index";}